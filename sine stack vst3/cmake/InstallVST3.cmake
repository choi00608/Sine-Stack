# Stage and verify a complete bundle before replacing the installed one. Renaming
# preserves the old executable's inode for hosts that still have it mapped.
if(NOT DEFINED SOURCE_BUNDLE OR NOT DEFINED DESTINATION_BUNDLE)
    message(FATAL_ERROR "SOURCE_BUNDLE and DESTINATION_BUNDLE are required")
endif()
get_filename_component(parent "${DESTINATION_BUNDLE}" DIRECTORY)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(stage "${parent}/.SineStack-install-${suffix}")
file(MAKE_DIRECTORY "${stage}")
execute_process(COMMAND /usr/bin/ditto "${SOURCE_BUNDLE}" "${stage}/new.vst3" RESULT_VARIABLE copied)
if(NOT copied EQUAL 0)
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "Could not stage the VST3 bundle; installation was not changed")
endif()
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${stage}/new.vst3" RESULT_VARIABLE verified)
if(NOT verified EQUAL 0)
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "Staged VST3 signature failed; installation was not changed")
endif()
if(EXISTS "${DESTINATION_BUNDLE}")
    file(RENAME "${DESTINATION_BUNDLE}" "${stage}/previous.vst3" RESULT moved)
    if(NOT moved STREQUAL "0")
        file(REMOVE_RECURSE "${stage}")
        message(FATAL_ERROR "Could not move previous VST3: ${moved}")
    endif()
endif()
file(RENAME "${stage}/new.vst3" "${DESTINATION_BUNDLE}" RESULT installed)
if(NOT installed STREQUAL "0")
    if(EXISTS "${stage}/previous.vst3")
        file(RENAME "${stage}/previous.vst3" "${DESTINATION_BUNDLE}" RESULT restored)
        if(NOT restored STREQUAL "0")
            message(FATAL_ERROR "Install failed; previous VST3 is retained at ${stage}/previous.vst3")
        endif()
    endif()
    file(REMOVE_RECURSE "${stage}")
    message(FATAL_ERROR "Could not install VST3: ${installed}")
endif()
file(REMOVE_RECURSE "${stage}")
message(STATUS "Installed ${DESTINATION_BUNDLE}")
